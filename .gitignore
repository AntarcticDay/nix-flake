
# .gitignore
# =============================================================================
# Git Ignore File for Nix Flake Project
#
# This file tells Git which files and directories to ignore (not track).
# Each pattern excludes matching files from version control.
#
# Pattern rules:
# - Lines starting with # are comments
# - Blank lines are ignored
# - Patterns starting with / match from repository root
# - Patterns ending with / match directories only
# - * matches any characters except /
# - ** matches any number of directories
# - ! negates a pattern (re-includes previously excluded files)
# =============================================================================

# =============================================================================
# Nix Build Outputs
# =============================================================================
#
# Nix creates these symlinks when building packages or systems.
# They point to build results in /nix/store.
# Never commit these as they're machine-specific.

# Default build result
result

# Multiple build results (from commands like: nix build .#package1 .#package2)
# Creates: result-1, result-2, etc.
result-*

# Alternative result names (if specified with --out-link)
result-bin
result-doc
result-lib
result-dev

# =============================================================================
# Development Environment
# =============================================================================

# ---------------------------------------------------------------------------
# direnv
# ---------------------------------------------------------------------------
#
# direnv automatically loads .envrc when entering the directory.
# The .direnv/ folder contains cached environment data.
# This is machine-specific and should never be committed.

.direnv/

# ---------------------------------------------------------------------------
# Nix Development Shells
# ---------------------------------------------------------------------------
#
# Some tools create shell environment caches

# nix-shell garbage collection roots
.gcroots/

# lorri daemon files (if using lorri instead of direnv)
.lorri/
shell.nix.lock

# =============================================================================
# Text Editors and IDEs
# =============================================================================
#
# Each editor creates temporary files and configuration directories.
# These are personal preferences and shouldn't be in the repository.

# ---------------------------------------------------------------------------
# Vim/Neovim
# ---------------------------------------------------------------------------

# Swap files (created while editing)
*.swp
*.swo
*.swn

# Backup files
*.backup
*.bak
*~

# Vim session files
Session.vim
.vim/

# Neovim
.nvim/
.nvimrc.lua.local

# ---------------------------------------------------------------------------
# Visual Studio Code
# ---------------------------------------------------------------------------

# VS Code workspace settings
.vscode/

# VS Code workspace files
*.code-workspace

# VS Code local history
.history/

# ---------------------------------------------------------------------------
# JetBrains IDEs (IntelliJ, WebStorm, etc.)
# ---------------------------------------------------------------------------

# IDE project files
.idea/

# IDE-specific files
*.iml
*.ipr
*.iws

# ---------------------------------------------------------------------------
# Emacs
# ---------------------------------------------------------------------------

# Emacs temporary files
\#*\#
.\#*

# Emacs auto-save files
*~

# Emacs desktop files
.emacs.desktop
.emacs.desktop.lock

# Projectile
.projectile

# Emacs directory configuration
.dir-locals.el

# ---------------------------------------------------------------------------
# Other Editors
# ---------------------------------------------------------------------------

# Sublime Text
*.sublime-workspace
*.sublime-project

# TextMate
*.tmproj
*.tmproject
tmtags

# Nova
.nova/

# Zed
.zed/

# =============================================================================
# Operating System Files
# =============================================================================

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------

# Finder metadata (stores folder view preferences)
.DS_Store

# Finder desktop configuration
Desktop.ini

# Resource forks (legacy Mac files)
._*

# Thumbnails
.Spotlight-V100
.Trashes

# Temporary files
.fseventsd
.TemporaryItems
.VolumeIcon.icns

# AppleDouble encoded files
.AppleDouble
.LSOverride

# Icon must end with two \r (carriage returns)
Icon

# ---------------------------------------------------------------------------
# Linux
# ---------------------------------------------------------------------------

# Trash folder
.Trash-*

# Thumbnail cache
.thumbnails/

# ---------------------------------------------------------------------------
# Windows (if collaborating with Windows users)
# ---------------------------------------------------------------------------

# Windows thumbnail cache
Thumbs.db
Thumbs.db:encryptable

# Windows folder config
Desktop.ini

# Recycle Bin
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows shortcuts
*.lnk

# =============================================================================
# Logs and Temporary Files
# =============================================================================

# ---------------------------------------------------------------------------
# Log Files
# ---------------------------------------------------------------------------
#
# Various tools create log files that shouldn't be committed

# General log files
*.log
*.log.*
logs/
log/

# Nix daemon logs
nix-daemon.log

# Build logs
build.log
test.log

# ---------------------------------------------------------------------------
# Temporary Files
# ---------------------------------------------------------------------------

# General temporary files
*.tmp
*.temp
tmp/
temp/

# Cache directories
.cache/
cache/

# =============================================================================
# Security and Secrets
# =============================================================================
#
# IMPORTANT: Never commit secrets or credentials!

# ---------------------------------------------------------------------------
# Environment Files
# ---------------------------------------------------------------------------

# Local environment variables (may contain secrets)
.env
.env.local
.env.*.local

# Shell environment files
.envrc.local
.envrc.private

# ---------------------------------------------------------------------------
# Credentials and Keys
# ---------------------------------------------------------------------------

# SSH keys
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# GPG keys
*.gpg
*.asc
secring.*

# API keys and tokens
.api-keys
.tokens
credentials.json
secrets.json

# ---------------------------------------------------------------------------
# Certificates
# ---------------------------------------------------------------------------

# SSL certificates
*.crt
*.csr
*.p12
*.pfx

# =============================================================================
# Build Artifacts and Dependencies
# =============================================================================

# ---------------------------------------------------------------------------
# Node.js (if any JavaScript tools are used)
# ---------------------------------------------------------------------------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/

# ---------------------------------------------------------------------------
# Python (if any Python tools are used)
# ---------------------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
.Python
venv/
env/
.venv

# ---------------------------------------------------------------------------
# Rust (if any Rust tools are used)
# ---------------------------------------------------------------------------

target/
Cargo.lock

# =============================================================================
# Project-Specific Ignores
# =============================================================================

# ---------------------------------------------------------------------------
# Nix-specific temporary files
# ---------------------------------------------------------------------------

# Nix profile generations (if using nix profile)
.nix-profile

# Nix channels (managed by flake)
.nix-channels

# Old Nix expressions (if migrating from non-flake)
default.nix
shell.nix
configuration.nix.backup

# ---------------------------------------------------------------------------
# Documentation build outputs
# ---------------------------------------------------------------------------

# Sphinx documentation
docs/_build/
_build/

# MkDocs
site/

# ---------------------------------------------------------------------------
# Backup files
# ---------------------------------------------------------------------------

# Time Machine backups (if accidentally created in project)
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# General backups
*.backup
*.bak
*.orig
backup/
backups/

# =============================================================================
# Exceptions (files to track despite patterns above)
# =============================================================================
#
# Use ! to force-include files that would otherwise be ignored
# Example: !important-file.log

# Ensure .envrc is tracked (it's part of the flake)
!.envrc

# =============================================================================
# Notes for Contributors
# =============================================================================
#
# When adding new patterns:
# 1. Add them to the appropriate section
# 2. Include a comment explaining what they're for
# 3. Test that important files aren't accidentally ignored
#
# To check what files are ignored:
# $ git status --ignored
#
# To see why a file is ignored:
# $ git check-ignore -v filename
#
# To force-add an ignored file:
# $ git add -f filename
